<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Password Reset Request</title>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        background-color: #f4f7fb;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
          Arial, sans-serif;
        color: #1f2937;
      }

      .wrapper {
        width: 100%;
        padding: 45px 16px;
      }

      .container {
        width: 100%;
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 12px 40px rgba(15, 23, 42, 0.08);
      }

      /* Header */
      .header {
        padding: 32px 30px;
        text-align: center;
        background: linear-gradient(135deg, #0f766e, #14b8a6);
        color: #ffffff;
      }

      .brand {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: -0.4px;
      }

      .brand-subtitle {
        margin: 6px 0 0;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.85);
      }

      /* Content */
      .content {
        padding: 42px 38px 35px;
        text-align: center;
      }

      .icon-wrapper {
        width: 72px;
        height: 72px;
        margin: 0 auto 24px;
        border-radius: 50%;
        background: #eff6ff;
        border: 8px solid #f8fbff;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .lock-icon {
        font-size: 30px;
        line-height: 1;
      }

      .title {
        margin: 0 0 12px;
        color: #111827;
        font-size: 27px;
        line-height: 1.3;
        font-weight: 700;
        letter-spacing: -0.6px;
      }

      .greeting {
        margin: 0 0 20px;
        color: #374151;
        font-size: 16px;
        line-height: 1.7;
      }

      .message {
        margin: 0 0 10px;
        color: #6b7280;
        font-size: 15px;
        line-height: 1.7;
      }

      /* OTP */
      .otp-wrapper {
        margin: 28px 0;
        padding: 24px 20px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
      }

      .otp-label {
        margin: 0 0 12px;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1.2px;
      }

      .otp {
        display: inline-block;
        padding: 14px 22px;
        min-width: 190px;
        border-radius: 10px;
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: #0f766e;
        font-size: 30px;
        line-height: 1.2;
        font-weight: 700;
        letter-spacing: 8px;
        text-align: center;
      }

      .expiration {
        margin: 14px 0 0;
        color: #64748b;
        font-size: 12px;
        line-height: 1.6;
      }

      .expiration strong {
        color: #334155;
      }

      /* Security Notice */
      .security-box {
        margin-top: 28px;
        padding: 16px 18px;
        text-align: left;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 10px;
      }

      .security-title {
        margin: 0 0 5px;
        color: #92400e;
        font-size: 13px;
        font-weight: 700;
      }

      .security-text {
        margin: 0;
        color: #78350f;
        font-size: 12px;
        line-height: 1.6;
      }

      /* Footer */
      .footer {
        padding: 24px 30px;
        text-align: center;
        background: #f8fafc;
        border-top: 1px solid #eef2f7;
      }

      .footer-text {
        margin: 0 0 7px;
        color: #64748b;
        font-size: 12px;
        line-height: 1.6;
      }

      .copyright {
        margin: 0;
        color: #94a3b8;
        font-size: 11px;
      }

      @media only screen and (max-width: 600px) {
        .wrapper {
          padding: 20px 12px;
        }

        .header {
          padding: 26px 20px;
        }

        .content {
          padding: 35px 22px 28px;
        }

        .title {
          font-size: 24px;
        }

        .greeting,
        .message {
          font-size: 14px;
        }

        .otp {
          font-size: 26px;
          letter-spacing: 6px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">

        <!-- Header -->
        <div class="header">
          <h1 class="brand">PH Healthcare System</h1>
          <p class="brand-subtitle">Secure • Trusted • Reliable</p>
        </div>

        <!-- Main Content -->
        <div class="content">

          <!-- Lock Icon -->
          <div class="icon-wrapper">
            <div class="lock-icon">🔐</div>
          </div>

          <h2 class="title">Password Reset Request</h2>

          <p class="greeting">
            Hello <strong><%= name %></strong>,
          </p>

          <p class="message">
            We received a request to reset the password associated with your
            PH Healthcare System account.
          </p>

          <p class="message">
            Please use the verification code below to continue.
          </p>

          <!-- OTP -->
          <div class="otp-wrapper">
            <p class="otp-label">Your Verification Code</p>

            <div class="otp">
              <%= otp %>
            </div>

            <p class="expiration">
              This code will expire in
              <strong><%= expirationMinutes %> minutes</strong>.
            </p>
          </div>

          <!-- Security Notice -->
          <div class="security-box">
            <p class="security-title">
              🔒 Security Notice
            </p>

            <p class="security-text">
              Never share this verification code with anyone. If you did not
              request a password reset, you can safely ignore this email.
            </p>
          </div>

        </div>

        
        <!-- Footer -->
        <div class="footer">
          <p class="footer-text">
            This is an automated security notification. Please do not reply
            directly to this email.
          </p>

          <p class="copyright">
            &copy; <%= new Date().getFullYear() %>
            PH Healthcare System. All rights reserved.
          </p>
        </div>

      </div>
    </div>
  </body>
</html>
