<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Password Reset Successful</title>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        background-color: #f4f7fb;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
          Arial, sans-serif;
        color: #1f2937;
      }

      .wrapper {
        width: 100%;
        padding: 45px 16px;
      }

      .container {
        width: 100%;
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 12px 40px rgba(15, 23, 42, 0.08);
      }

      /* Header */
      .header {
        padding: 32px 30px;
        text-align: center;
        background: linear-gradient(135deg, #0f766e, #14b8a6);
        color: #ffffff;
      }

      .brand {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: -0.4px;
      }

      .brand-subtitle {
        margin: 6px 0 0;
        font-size: 13px;
        color: rgba(255, 255, 255, 0.85);
      }

      /* Content */
      .content {
        padding: 42px 38px 35px;
        text-align: center;
      }

      .icon-wrapper {
        width: 76px;
        height: 76px;
        margin: 0 auto 24px;
        border-radius: 50%;
        background: #ecfdf5;
        border: 8px solid #f0fdf4;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .icon {
        color: #16a34a;
        font-size: 34px;
        font-weight: 700;
        line-height: 1;
      }

      .title {
        margin: 0 0 12px;
        color: #111827;
        font-size: 28px;
        line-height: 1.25;
        font-weight: 700;
        letter-spacing: -0.7px;
      }

      .greeting {
        margin: 0 0 20px;
        color: #374151;
        font-size: 16px;
        line-height: 1.7;
      }

      .message {
        margin: 0 0 22px;
        color: #6b7280;
        font-size: 15px;
        line-height: 1.7;
      }

      /* CTA */
      .button-wrapper {
        margin: 30px 0;
      }

      .button {
        display: inline-block;
        padding: 13px 28px;
        border-radius: 9px;
        background: #0f766e;
        color: #ffffff !important;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
      }

      /* Security notice */
      .security-box {
        margin-top: 28px;
        padding: 16px 18px;
        text-align: left;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 10px;
      }

      .security-title {
        margin: 0 0 5px;
        color: #92400e;
        font-size: 13px;
        font-weight: 700;
      }

      .security-text {
        margin: 0;
        color: #78350f;
        font-size: 12px;
        line-height: 1.6;
      }

      /* Footer */
      .footer {
        padding: 24px 30px;
        text-align: center;
        background: #f8fafc;
        border-top: 1px solid #eef2f7;
      }

      .footer-text {
        margin: 0 0 7px;
        color: #64748b;
        font-size: 12px;
        line-height: 1.6;
      }

      .copyright {
        margin: 0;
        color: #94a3b8;
        font-size: 11px;
      }

      @media only screen and (max-width: 600px) {
        .wrapper {
          padding: 20px 12px;
        }

        .content {
          padding: 35px 22px 28px;
        }

        .header {
          padding: 26px 20px;
        }

        .title {
          font-size: 24px;
        }

        .greeting,
        .message {
          font-size: 14px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">

        <!-- Header -->
        <div class="header">
          <h1 class="brand">PH Healthcare System</h1>
          <p class="brand-subtitle">Secure • Trusted • Reliable</p>
        </div>

        <!-- Main Content -->
        <div class="content">

          <!-- Success Icon -->
          <div class="icon-wrapper">
            <div class="icon">&#10003;</div>
          </div>

          <h2 class="title">Password Reset Successful</h2>

          <p class="greeting">
            Hello <strong><%= name %></strong>,
          </p>

          <p class="message">
            Your password has been successfully changed. Your account is now
            secured with your new password.
          </p>

          <p class="message">
            You can now sign in to your PH Healthcare System account using your
            new credentials.
          </p>

          <!-- CTA -->
          <div class="button-wrapper">
            <a href="<%= loginUrl %>" class="button">
              Sign In to Your Account
            </a>
          </div>

          <!-- Security Notice -->
          <div class="security-box">
            <p class="security-title">
              🔒 Security Notice
            </p>

            <p class="security-text">
              If you did not make this password change, please contact our
              support team immediately and secure your account.
            </p>
          </div>

        </div>

        <!-- Footer -->
        <div class="footer">
          <p class="footer-text">
            This is an automated security notification. Please do not reply
            directly to this email.
          </p>

          <p class="copyright">
            &copy; <%= new Date().getFullYear() %>
            PH Healthcare System. All rights reserved.
          </p>
        </div>

      </div>
    </div>
  </body>
</html>
